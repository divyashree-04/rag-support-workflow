                  "useDeno": true,
                  "sampleData": {},
                  "sourceCode": {
                    "code": "export const code = async (inputs: { raw: any; topScore: number; threshold: any; question: string }) => {\n  const topScore = Number(inputs.topScore) || 0;\n  const threshold = Number(inputs.threshold) || 0.3;\n  const question = String(inputs.question ?? \"\");\n\n  const fail = (reason: string) => ({\n    valid: false, route: \"escalate\", reason,\n    answer: \"\", confidence: 0, sourcesText: \"\",\n    topScore, timestamp: new Date().toISOString(),\n  });\n\n  // 1. Input screen: escalate unusable or suspicious questions before trusting the AI\n  const injection = /(ignore|disregard|forget|override).{0,40}(instruction|rule|prompt|polic|context)|system prompt|your instructions|reveal.{0,30}(prompt|instruction|key|password)|you are now|developer mode|jailbreak|pretend (to be|you)/i;\n  if (question.trim().length < 5) return fail(\"question_too_short\");\n  if (question.length > 1000) return fail(\"question_too_long\");\n  if (injection.test(question)) return fail(\"possible_prompt_injection\");\n\n  // 2. Parse the AI reply\n  let p: any = null;\n  const r = inputs.raw;\n  if (r === undefined || r === null || r === \"\") return fail(\"ai_step_failed\");\n  if (r && typeof r === \"object\" && \"can_answer\" in r) {\n    p = r;\n  } else {\n    let t = typeof r === \"string\" ? r : JSON.stringify(r ?? \"\");\n    t = t.replace(/```json|```/gi, \"\").trim();\n    const s = t.indexOf(\"{\"), e = t.lastIndexOf(\"}\");\n    if (s < 0 || e <= s) return fail(\"bad_json\");\n    try { p = JSON.parse(t.slice(s, e + 1)); } catch { return fail(\"bad_json\"); }\n  }\n\n  // 3. Schema check\n  const ok = typeof p.can_answer === \"boolean\" && typeof p.answer === \"string\"\n          && typeof p.confidence === \"number\" && Array.isArray(p.sources);\n  if (!ok) return fail(\"schema_mismatch\");\n\n  // 4. All checks must pass to auto-reply (includes output guards)\n  const text: string = p.answer;\n  const known = [\"help@brightcart.example\", \"privacy@brightcart.example\", \"business@brightcart.example\"];\n  const emails: string[] = text.match(/[\\w.+-]+@[\\w-]+\\.[\\w.-]+/g) || [];\n  const checks = {\n    canAnswer: p.can_answer === true,\n    hasAnswer: text.trim().length > 0,\n    confident: p.confidence >= 0.8,\n    retrievalOk: topScore >= threshold,\n    noUrls: !/(https?:\\/\\/|www\\.)/i.test(text),\n    noUnknownEmails: emails.every(e => known.includes(e.toLowerCase())),\n    noPromises: !/(refund (has been|is|was) (approved|issued|processed|granted)|i (have|'ve) (approved|issued|processed|refunded)|i will (approve|issue|refund))/i.test(text),\n    noLeak: !/(system prompt|my instructions|as an ai language model)/i.test(text),\n  };\n  const auto = Object.values(checks).every(Boolean);\n  const failed = Object.entries(checks).filter(([, v]) => !v).map(([k]) => k);\n\n  return {\n    valid: true,\n    route: auto ? \"auto\" : \"escalate\",\n    reason: auto ? \"passed_all_checks\" : \"failed: \" + failed.join(\", \"),\n    answer: p.answer,\n    confidence: p.confidence,\n    sourcesText: p.sources.join(\"; \"),\n    topScore,\n    timestamp: new Date().toISOString(),\n  };\n};",
