              "useDeno": true,
              "sampleData": {},
              "sourceCode": {
                "code": "export const code = async (inputs: { docText: any; question: string }) => {\n  // 1. Turn Google's structured doc content into plain text\n  let raw: any = inputs.docText;\n  if (typeof raw === \"string\") {\n    try { raw = JSON.parse(raw); } catch { /* already plain text */ }\n  }\n  let text = \"\";\n  if (typeof raw === \"string\") {\n    text = raw;\n  } else {\n    const walk = (n: any) => {\n      if (Array.isArray(n)) { n.forEach(walk); return; }\n      if (n && typeof n === \"object\") {\n        if (n.textRun && typeof n.textRun.content === \"string\") text += n.textRun.content;\n        for (const k of Object.keys(n)) if (k !== \"textRun\") walk(n[k]);\n      }\n    };\n    walk(raw);\n  }\n\n  // 2. Split into KB entries\n  const stop = new Set([\"the\",\"and\",\"for\",\"are\",\"how\",\"what\",\"can\",\"does\",\"you\",\"your\",\"with\",\"this\",\"that\",\"have\",\"from\",\"will\",\"not\"]);\n  const tok = (s: string) =>\n    s.toLowerCase().replace(/[^a-z0-9\\s]/g, \" \").split(/\\s+/)\n      .filter(w => w.length > 2 && !stop.has(w));\n\n  const entries = text\n    .split(/^TITLE:/m).map(s => s.trim()).filter(Boolean)\n    .map(e => { const [t, ...r] = e.split(\"\\n\"); return { title: t.trim(), content: r.join(\" \").trim() }; })\n    .filter(e => e.content);\n\n  // 3. Score entries against the question\n  const q = new Set(tok(inputs.question));\n  const scored = entries.map(e => {\n    const words = new Set(tok(e.title + \" \" + e.content));\n    let hit = 0;\n    q.forEach(w => { if (words.has(w)) hit++; });\n    return { ...e, score: q.size ? hit / q.size : 0 };\n  }).sort((a, b) => b.score - a.score).slice(0, 4);\n\n  return {\n    context: scored.map((x, i) => `[${i + 1}] (${x.title}) ${x.content}`).join(\"\\n\\n\"),\n    topScore: scored.length ? scored[0].score : 0,\n    sources: scored.map(x => x.title),\n    entryCount: entries.length,\n    textLength: text.length,\n  };\n};",
                "packageJson": "{}"
              },
